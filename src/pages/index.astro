---
import EssayList from '../components/EssayList.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import Photo from '../components/Photo.astro';
import { SITE } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedEssays } from '../lib/essays';
import { getPageCopy } from '../lib/pages';
import { PHOTOS } from '../lib/photos';

// All wording on this page comes from src/content/pages/home.md, except the
// empty-state line, which lives with the rest of the article wording.
const copy = await getPageCopy('home');
const articleCopy = await getPageCopy('articles');
// Three, so the latest articles fill exactly one row of cards on laptops.
const recent = (await getPublishedEssays()).slice(0, 3);
---

<BaseLayout description={copy.description}>
	<h1 class="sr-only">{SITE.name}</h1>

	<div class="lede" set:html={copy.block('statement')} />
	<p class="meta byline" set:html={copy.inline('byline')} />

	<section class="section" aria-labelledby="recent-heading">
		<div class="section-head">
			<h2 id="recent-heading" class="meta label" set:html={copy.inline('recent-heading')} />
			{recent.length > 0 && <a class="meta" href="/articles/" set:html={copy.inline('all-articles-link')} />}
		</div>
		{
			recent.length > 0 ? (
				<EssayList essays={recent} headingLevel={3} layout="grid" />
			) : (
				<div class="empty prose" set:html={articleCopy.block('empty-state')} />
			)
		}
	</section>

	<section class="section about" aria-labelledby="about-heading">
		<Photo photo={PHOTOS.home} sizes="(min-width: 48em) 14rem, 9rem" class="about-photo" />
		<div class="about-text">
			<h2 id="about-heading" set:html={copy.inline('about-heading')} />
			<div class="about-copy" set:html={copy.block('about-text')} />
			<p class="more"><a href="/about/" set:html={copy.inline('about-link')} /></p>
		</div>
	</section>

	<NewsletterSignup
		placement="home"
		heading={copy.inline('signup-heading')}
		text={copy.block('signup-text')}
	/>
</BaseLayout>

<style>
	.lede {
		max-width: 24em;
		font-size: var(--text-lede);
		line-height: 1.4;
		letter-spacing: -0.005em;
		text-wrap: pretty;
	}

	.lede :global(p + p) {
		margin-top: 0.75em;
	}

	.byline {
		margin-top: 1rem;
	}

	.section {
		margin-top: var(--space-section);
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.75rem;
	}

	.label {
		font-weight: 500;
	}

	.section-head a {
		color: var(--color-accent);
	}

	.empty {
		max-width: var(--measure);
	}

	.about {
		display: grid;
		gap: 1.5rem;
	}

	.about :global(.about-photo) {
		width: 9rem;
	}

	.about-text {
		max-width: var(--measure);
	}

	.about-copy :global(p) {
		margin-top: 0.75rem;
	}

	.about-text .more {
		margin-top: 1rem;
	}

	@media (min-width: 48em) {
		.about {
			grid-template-columns: 14rem minmax(0, var(--measure));
			align-items: center;
			gap: 3rem;
		}

		.about :global(.about-photo) {
			width: 100%;
		}
	}

	/*
	  From laptop width the statement runs on one line: at --text-lede (34px) it needs about
	  29em, and the page frame gives 70rem, so the 24em cap was the only thing wrapping it.
	  Dropping the cap keeps the block above the first essay card one line tall instead of two.
	  It stays capped on narrower screens, where it has to wrap anyway. If the statement is
	  ever rewritten much longer than about 29em it will wrap again, which is the right
	  outcome rather than a line running the full width of a wide screen.
	*/
	@media (min-width: 64em) {
		.lede {
			max-width: none;
		}
	}
</style>
