---
import EssayList from '../../components/EssayList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedEssays } from '../../lib/essays';
import { getPageCopy } from '../../lib/pages';

// Wording comes from src/content/pages/articles.md.
const copy = await getPageCopy('articles');
const essays = await getPublishedEssays();
---

<BaseLayout title={copy.text('heading')} description={copy.description}>
	<header class="page-header">
		<h1 set:html={copy.inline('heading')} />
		<div class="intro" set:html={copy.block('intro')} />
	</header>
	<EssayList essays={essays} headingLevel={2} layout="index" />
</BaseLayout>

<style>
	.intro {
		margin-top: 0.5rem;
		color: var(--color-text-muted);
	}
</style>
