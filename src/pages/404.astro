---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageCopy } from '../lib/pages';

// Wording comes from src/content/pages/site.md.
const copy = await getPageCopy('site');
---

<BaseLayout title={copy.text('not-found-heading')} noindex>
	<div class="reading">
		<header class="page-header">
			<h1 set:html={copy.inline('not-found-heading')} />
		</header>
		<div class="prose" set:html={copy.block('not-found-text')} />
	</div>
</BaseLayout>
