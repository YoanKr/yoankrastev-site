---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
	<div class="reading">
		<header class="page-header">
			<h1>Page not found</h1>
		</header>
		<div class="prose">
			<p>
				That page doesn’t exist, or it has moved. Everything I’ve written is on the <a href="/articles/"
					>Articles page</a
				>.
			</p>
		</div>
	</div>
</BaseLayout>
