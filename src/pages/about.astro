---
import Photo from '../components/Photo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageCopy } from '../lib/pages';
import { PHOTOS } from '../lib/photos';

// Wording comes from src/content/pages/about.md; photos from src/lib/photos.ts.
const copy = await getPageCopy('about');
const rows = PHOTOS.about.map((photo, i) => ({ photo, html: copy.block(`row-${i + 1}`) }));
const photoSizes = '(min-width: 48em) 40vw, 100vw';
---

<BaseLayout title={copy.text('heading')} description={copy.description}>
	<header class="page-header">
		<h1 set:html={copy.inline('heading')} />
	</header>

	<!--
		Rows alternate photo and text: photo left, right, left on laptops (every other row is flipped).
		On phones every row stacks: photo, then text. The closing paragraph spans the page.
	-->
	<div class="rows">
		{
			rows.map(({ photo, html }, i) => (
				<section class:list={['row', { flip: i % 2 === 1 }]}>
					<Photo photo={photo} sizes={photoSizes} />
					<div class="prose" set:html={html} />
				</section>
			))
		}
	</div>

	<div class="closing prose" set:html={copy.block('closing')} />
</BaseLayout>

<style>
	.rows {
		display: grid;
		gap: 3.5rem;
	}

	.row {
		display: grid;
		gap: 1.5rem;
	}

	.row .prose {
		max-width: var(--measure);
	}

	@media (min-width: 48em) {
		.rows {
			gap: 6rem;
		}

		.row {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: center;
			gap: 4rem;
		}

		/* Flipped rows put the photo on the right. */
		.row.flip {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		}

		.row.flip > :global(.photo) {
			order: 2;
		}

		.row.flip .prose {
			justify-self: end;
		}
	}

	.closing {
		max-width: 36em;
		margin-top: 5rem;
		font-size: var(--text-closing);
		line-height: 1.55;
	}

	@media (min-width: 48em) {
		.closing {
			margin-top: 7rem;
		}
	}
</style>
