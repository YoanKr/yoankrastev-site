---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPageCopy } from '../../lib/pages';

// Where /api/subscribe sends a reader once beehiiv has them. Wording: content/pages/newsletter.md.
const copy = await getPageCopy('newsletter');
---

<BaseLayout title={copy.text('thank-you-heading')} description={copy.description} noindex>
	<div class="reading">
		<header class="page-header">
			<h1 set:html={copy.inline('thank-you-heading')} />
		</header>
		<div class="prose" set:html={copy.block('thank-you-text')} />
	</div>
</BaseLayout>
