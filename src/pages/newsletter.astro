---
import NewsletterSignup from '../components/NewsletterSignup.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPageCopy } from '../lib/pages';

// Wording comes from src/content/pages/newsletter.md.
const copy = await getPageCopy('newsletter');
---

<BaseLayout title={copy.text('heading')} description={copy.description}>
	<div class="reading">
		<header class="page-header">
			<h1 set:html={copy.inline('heading')} />
		</header>

		<div class="prose" set:html={copy.block('text')} />

		<NewsletterSignup placement="newsletter" class="signup" />
	</div>
</BaseLayout>

<style>
	.signup {
		margin-top: 2.5rem;
	}
</style>
