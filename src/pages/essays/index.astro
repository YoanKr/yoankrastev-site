---
import EssayList from '../../components/EssayList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedEssays } from '../../lib/essays';
import { getPageCopy } from '../../lib/pages';

// Wording comes from src/content/pages/essays.md.
const copy = await getPageCopy('essays');
const essays = await getPublishedEssays();
---

<BaseLayout title={copy.text('heading')} description={copy.description}>
	<header class="page-header">
		<h1 set:html={copy.inline('heading')} />
		{essays.length > 0 && <div class="intro" set:html={copy.block('intro')} />}
	</header>
	{
		essays.length > 0 ? (
			<EssayList essays={essays} headingLevel={2} layout="index" />
		) : (
			<div class="empty prose" set:html={copy.block('empty-state')} />
		)
	}
</BaseLayout>

<style>
	.intro {
		margin-top: 0.5rem;
		color: var(--color-text-muted);
	}

	.empty {
		max-width: var(--measure);
	}
</style>
