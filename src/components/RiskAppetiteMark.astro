---
/**
 * The Risk Appetite mark: a bell curve with its right tail filled in.
 * Traced from Yoan's logo file (800×800 PNG) so it stays sharp at any size and follows the theme:
 * the curve is drawn in the text colour, the tail in --color-mark-tail.
 * Purely decorative next to the newsletter's name, so it is hidden from screen readers.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

