---
import { type Essay, essayUrl, readingTime } from '../lib/essays';
import FormattedDate from './FormattedDate.astro';

interface Props {
	essays: Essay[];
	/** Heading level for each essay title, so the page outline stays correct. */
	headingLevel?: 2 | 3;
	/**
	 * 'grid'  (homepage): compact cards in auto-fit columns, 1 on phones, 2 on laptops.
	 * 'index' (/articles): one long card per row, with date, reading time and tags in their own
	 *         column on wider screens.
	 * Both are panels (soft-edged boxes) and the whole card is the link.
	 */
	layout?: 'grid' | 'index';
}

const { essays, headingLevel = 2, layout = 'index' } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<ul class:list={['essay-list', layout]}>
	{
		essays.map((essay) => (
			<li class="panel">
				<Heading class="title">
					<a href={essayUrl(essay)}>{essay.data.title}</a>
				</Heading>
				<div class="meta">
					<FormattedDate date={essay.data.pubDate} />
					{layout === 'index' && (
						<>
							<span class="sep" aria-hidden="true">
								&ensp;·&ensp;
							</span>
							<span>{readingTime(essay.body)} min read</span>
							{essay.data.tags && essay.data.tags.length > 0 && (
								<>
									<span class="sep" aria-hidden="true">
										&ensp;·&ensp;
									</span>
									<span class="tags">{essay.data.tags.join(', ')}</span>
								</>
							)}
						</>
					)}
					{essay.data.draft && <span class="draft"> · Draft (hidden in production)</span>}
				</div>
				<p class="excerpt">{essay.data.description}</p>
			</li>
		))
	}
</ul>

<style>
	.essay-list {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 48em) {
		.essay-list {
			gap: 1.5rem;
		}
	}

	.grid {
		/* 24rem minimum: one column on phones, two on laptops (three would leave the fourth card alone). */
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
	}

	/*
	  The whole card is the link (the title's ::after covers it), so it is easy to tap on a phone.
	  Hovering anywhere on the card colours the title.
	*/
	li {
		position: relative;
	}

	.title {
		font-size: var(--text-list-title);
	}

	.title a {
		color: var(--color-text);
		text-decoration: none;
	}

	.title a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	li:hover .title a {
		color: var(--color-accent);
	}

	.meta {
		margin-top: 0.25rem;
	}

	.meta > :global(*) {
		white-space: nowrap;
	}

	.excerpt {
		max-width: var(--measure);
		margin-top: 0.375rem;
	}

	.draft {
		color: var(--color-accent);
	}

	/* /articles on wider screens: date, reading time and tags stacked in a column left of the title. */
	@media (min-width: 48em) {
		.index li {
			display: grid;
			grid-template-columns: 10rem minmax(0, 1fr);
			grid-template-areas:
				'meta title'
				'meta excerpt';
			align-items: start;
			column-gap: 2.5rem;
		}

		.index .title {
			grid-area: title;
		}

		.index .meta {
			display: flex;
			flex-direction: column;
			grid-area: meta;
			margin-top: 0;
			/* Line the date up with the first line of the title. */
			padding-top: 0.3em;
		}

		.index .sep {
			display: none;
		}

		.index .tags {
			white-space: normal;
		}

		.index .excerpt {
			grid-area: excerpt;
		}
	}
</style>
