---
import { Image } from 'astro:assets';
import { type Essay, essayUrl, readingTime } from '../lib/essays';
import FormattedDate from './FormattedDate.astro';

interface Props {
	essays: Essay[];
	/** Heading level for each essay title, so the page outline stays correct. */
	headingLevel?: 2 | 3;
	/**
	 * 'grid'  (homepage): compact cards in auto-fit columns, 1 on phones, 2 on laptops.
	 * 'index' (/articles): one long card per row. With a thumbnail it is picture-left, newspaper
	 *         style; without one, the date and reading time sit in their own left column.
	 * Both are panels (soft-edged boxes) and the whole card is the link.
	 */
	layout?: 'grid' | 'index';
}

const { essays, headingLevel = 2, layout = 'index' } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<ul class:list={['essay-list', layout]}>
	{
		essays.map((essay) => (
			<li class:list={['panel', { illustrated: essay.data.thumbnail }]}>
				{essay.data.thumbnail && (
					<Image
						class="thumb"
						src={essay.data.thumbnail}
						alt={essay.data.thumbnailAlt ?? ''}
						widths={[320, 480, 720]}
						sizes="(min-width: 64em) 22rem, (min-width: 48em) 45vw, 90vw"
					/>
				)}
				<Heading class="title">
					<a href={essayUrl(essay)}>{essay.data.title}</a>
				</Heading>
				<div class="meta">
					<FormattedDate date={essay.data.pubDate} />
					{layout === 'index' && (
						<>
							<span class="sep" aria-hidden="true">
								&ensp;·&ensp;
							</span>
							<span>{readingTime(essay.body)} min read</span>
						</>
					)}
					{essay.data.draft && <span class="draft"> · Draft (hidden in production)</span>}
				</div>
				<p class="excerpt">{essay.data.description}</p>
			</li>
		))
	}
</ul>

<style>
	.essay-list {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 48em) {
		.essay-list {
			gap: 1.5rem;
		}
	}

	.grid {
		/*
		  18rem minimum: one column on phones, two on tablets, three in a row on laptops.
		  auto-FILL, not auto-fit: the empty columns stay, so one or two articles keep their
		  card the same size as they will be in a full row of three, with the rest of the row
		  left empty. auto-fit would collapse the empty tracks and blow a single card up to
		  the full width of the page.
		*/
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
	}

	/*
	  The whole card is the link (the title's ::after covers it), so it is easy to tap on a phone.
	  Hovering anywhere on the card colours the title.
	*/
	li {
		position: relative;
	}

	/*
	  Article thumbnails are line art at 1.9:1, the same shape as a social preview, so one
	  drawing serves both. They sit above the title on a homepage card. Transparent artwork on
	  the panel, inverted in dark mode for the same reason as the figures inside an article.
	*/
	.thumb {
		width: 100%;
		height: auto;
		aspect-ratio: 1.9 / 1;
		margin-bottom: 1rem;
		object-fit: contain;
	}

	:global([data-theme='dark']) .thumb {
		filter: invert(1) hue-rotate(180deg);
	}

	.title {
		font-size: var(--text-list-title);
	}

	.title a {
		color: var(--color-text);
		text-decoration: none;
	}

	.title a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	li:hover .title a {
		color: var(--color-accent);
	}

	.meta {
		margin-top: 0.25rem;
	}

	.meta > :global(*) {
		white-space: nowrap;
	}

	.excerpt {
		max-width: var(--measure);
		margin-top: 0.375rem;
	}

	.draft {
		color: var(--color-accent);
	}

	/* On /articles a thumbnail sits left of the text, newspaper style; the row's meta line
	   moves under the excerpt, because the left column is now the picture. */
	.index .thumb {
		margin-bottom: 0.75rem;
	}

	/* /articles on wider screens: date and reading time stacked in a column left of the title. */
	@media (min-width: 48em) {
		.index li {
			display: grid;
			grid-template-columns: 10rem minmax(0, 1fr);
			grid-template-areas:
				'meta title'
				'meta excerpt';
			align-items: start;
			column-gap: 2.5rem;
		}

		.index .title {
			grid-area: title;
		}

		.index .meta {
			display: flex;
			flex-direction: column;
			grid-area: meta;
			margin-top: 0;
			/* Line the date up with the first line of the title. */
			padding-top: 0.3em;
		}

		.index .sep {
			display: none;
		}

		.index .excerpt {
			grid-area: excerpt;
		}

		.index li.illustrated {
			padding-block: calc(var(--space-panel) * 0.6);
			grid-template-columns: 13rem minmax(0, 1fr);
			grid-template-areas:
				'thumb title'
				'thumb excerpt'
				'thumb meta';
			column-gap: 2rem;
		}

		.index li.illustrated .thumb {
			grid-area: thumb;
			margin-bottom: 0;
		}

		.index li.illustrated .excerpt {
			max-width: none;
		}

		.index li.illustrated .meta {
			flex-direction: row;
			flex-wrap: wrap;
			margin-top: 0.625rem;
		}

		/* Back on one line, so the parts need their separators again. */
		.index li.illustrated .sep {
			display: inline;
		}
	}
</style>
