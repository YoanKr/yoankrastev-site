---
import { getPageCopy } from '../lib/pages';

// Menu labels come from src/content/pages/site.md.
const copy = await getPageCopy('site');
const links = [
	{ href: '/articles/', label: copy.inline('menu-articles') },
	{ href: '/about/', label: copy.inline('menu-about') },
	{ href: '/newsletter/', label: copy.inline('menu-newsletter') },
];

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header">
	<div class="wrap">
		<a class="home" href="/" aria-current={path === '/' ? 'page' : undefined} set:html={copy.inline('menu-home')} />
		<nav aria-label="Main">
			<ul>
				{
					links.map(({ href, label }) => (
						<li>
							<a href={href} aria-current={isCurrent(href) ? 'page' : undefined} set:html={label} />
						</li>
					))
				}
			</ul>
		</nav>
		<!--
			Light/dark switch. Clicks and aria-checked are handled by the theme script in BaseHead.astro.
			The knob is a dot in light mode and a crescent in dark mode, drawn in CSS below.
		-->
		<button class="theme-switch" type="button" role="switch" aria-checked="false" title="Dark mode" data-theme-toggle>
			<span class="sr-only">Dark mode</span>
			<span class="track" aria-hidden="true"><span class="knob"></span></span>
		</button>
	</div>
</header>

<style>
	.site-header {
		padding-block: 1.25rem 0;
		font-family: var(--font-sans);
		font-size: var(--text-nav);
	}

	/* Phones: one row, wrapping only on very narrow screens. Wider: Home left, nav and switch right. */
	.wrap {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
	}

	nav {
		margin-right: auto;
	}

	@media (min-width: 40em) {
		.site-header {
			padding-block: 2rem 0;
		}

		.wrap {
			gap: 0.5rem 1.75rem;
		}

		.home {
			margin-right: auto;
		}

		nav {
			margin-right: 0;
		}
	}

	ul {
		display: flex;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	@media (min-width: 40em) {
		ul {
			gap: 1.5rem;
		}
	}

	a {
		color: var(--color-text-muted);
		text-decoration: none;
	}

	.home {
		color: var(--color-text);
		font-weight: 600;
	}

	nav a[aria-current='page'] {
		color: var(--color-text);
	}

	a:hover {
		color: var(--color-accent);
	}

	/* Theme switch */

	.theme-switch {
		display: inline-flex;
		margin: 0 0 0 auto; /* stays right-aligned if it wraps on very narrow phones */
		padding: 0.25rem 0;
		border: 0;
		background: none;
		color: var(--color-text);
		cursor: pointer;
	}

	@media (min-width: 40em) {
		.theme-switch {
			margin-left: 0;
		}
	}

	.track {
		position: relative;
		display: block;
		width: 2.5rem;
		height: 1.375rem;
		border: 1.5px solid var(--color-text-muted);
		border-radius: 1rem;
	}

	.knob {
		position: absolute;
		top: 50%;
		left: 0.1875rem;
		width: 0.875rem;
		height: 0.875rem;
		border-radius: 50%;
		background: currentColor;
		transform: translateY(-50%);
		transition: transform 0.15s ease;
	}

	/* Dark: knob slides right and becomes a crescent (a background-coloured circle bites into it). */
	:global([data-theme='dark']) .knob {
		transform: translate(1.125rem, -50%);
	}

	:global([data-theme='dark']) .knob::after {
		content: '';
		position: absolute;
		top: -0.1875rem;
		right: -0.1875rem;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		background: var(--color-bg);
	}

	.theme-switch:hover {
		color: var(--color-accent);
	}

	.theme-switch:hover .track {
		border-color: var(--color-accent);
	}

	@media (prefers-reduced-motion: reduce) {
		.knob {
			transition: none;
		}
	}

	/* Without JavaScript the switch can't work, so hide it. */
	:global(:root:not([data-theme])) .theme-switch {
		display: none;
	}
</style>
