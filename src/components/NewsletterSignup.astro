---
/**
 * Newsletter signup: the Risk Appetite mark and name, a pitch, an email field and one button.
 * The form posts to /api/subscribe, which subscribes the reader through the beehiiv API and
 * sends them to /newsletter/thank-you/. If that route cannot subscribe them (no API key
 * configured, beehiiv down, an address it rejects) it falls back to the beehiiv signup page,
 * so the button always works. No JavaScript: this is a plain HTML form.
 * Used on the homepage, at the end of every essay, on /about and on /newsletter.
 * The field, button and note wording comes from src/content/pages/newsletter.md.
 */
import { getPageCopy } from '../lib/pages';
import RiskAppetiteMark from './RiskAppetiteMark.astro';

interface Props {
	/** Where it sits ('home', 'essay', 'about', 'newsletter'). Sent to beehiiv as utm_medium. */
	placement: string;
	/** Optional heading, as inline HTML from a page's wording file. */
	heading?: string;
	/** Optional pitch under the heading, as HTML from a page's wording file. */
	text?: string;
	/** Draw it as a panel (soft-edged box). Boxed on the homepage, under articles and on /about; plain on /newsletter. */
	boxed?: boolean;
	/** Lets a page adjust spacing with its own scoped class. */
	class?: string;
}

const { placement, heading, text, boxed = true, class: className, ...rest } = Astro.props;
const headingId = `newsletter-heading-${placement}`;
const fieldId = `newsletter-email-${placement}`;
const copy = await getPageCopy('newsletter');
---

<section
	class:list={['newsletter', { panel: boxed }, className]}
	aria-labelledby={heading ? headingId : undefined}
	aria-label={heading ? undefined : 'Newsletter'}
	{...rest}
>
	<div class="layout">
		{
			(heading || text) && (
				<div class="text">
					{heading && (
						<h2 id={headingId} class="heading">
							<RiskAppetiteMark class="mark" />
							<span set:html={heading} />
						</h2>
					)}
					{text && <div class="pitch" set:html={text} />}
				</div>
			)
		}
		<form class="action" method="post" action="/api/subscribe">
			<div class="row">
				<label class="sr-only" for={fieldId} set:html={copy.inline('email-label')} />
				<input
					class="field"
					id={fieldId}
					type="email"
					name="email"
					required
					autocomplete="email"
					autocapitalize="off"
					spellcheck="false"
					placeholder={copy.text('email-placeholder')}
				/>
				<button class="button" type="submit" set:html={copy.inline('button')} />
			</div>
			<input type="hidden" name="placement" value={placement} />
			{/* Honeypot: hidden from people, irresistible to bots. A filled one is dropped silently. */}
			<div class="decoy" aria-hidden="true">
				<label for={`${fieldId}-company`}>Company</label>
				<input id={`${fieldId}-company`} type="text" name="company" tabindex="-1" autocomplete="off" />
			</div>
			<p class="meta note" set:html={copy.inline('button-note')} />
		</form>
	</div>
</section>

<style>
	/*
	  Phones and narrow boxes: mark and name, pitch, then the field and button under the pitch.
	  Where the box has room (container query): text on the left, form on the right,
	  centred vertically, so the box is neither half-empty nor tall.
	*/
	.newsletter {
		margin-top: var(--space-section);
		container-type: inline-size;
	}

	/* Boxed: a panel across the full width of its column, a little shorter than other panels. */
	.newsletter.panel {
		padding-block: calc(var(--space-panel) * 0.75);
	}

	.layout {
		display: grid;
		gap: 1.5rem;
	}

	.text {
		max-width: var(--measure);
	}

	.heading {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}

	.heading :global(.mark) {
		flex: none;
		height: 1.25em;
	}

	.pitch {
		margin-top: 0.5rem;
	}

	.pitch :global(p + p) {
		margin-top: 1em;
	}

	.row {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.field,
	.button {
		min-height: 3rem;
		border-radius: 2px;
		font-family: var(--font-sans);
		/* Keep at 1rem or more: iOS zooms into anything smaller when it gets focus. */
		font-size: var(--text-button);
		line-height: 1.2;
	}

	.field {
		min-width: 0;
		padding: 0.75rem 0.875rem;
		border: 1px solid var(--color-field-border);
		background: var(--color-bg);
		color: var(--color-text);
	}

	.field::placeholder {
		color: var(--color-text-muted);
		opacity: 1;
	}

	.field:focus {
		border-color: var(--color-text);
	}

	.button {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.75rem;
		border: 0;
		background: var(--color-text);
		color: var(--color-bg);
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
	}

	.button:hover {
		background: var(--color-accent);
	}

	/* Off-screen rather than display:none, which some bots skip. */
	.decoy {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.note {
		margin-top: 0.625rem;
	}

	@media (min-width: 30em) {
		.row {
			flex-direction: row;
		}

		.field {
			flex: 1;
		}

		.button {
			display: inline-flex;
			flex: none;
		}
	}

	/* Medium boxes (the article column): text full width, then the form across it. */
	@container (min-width: 30rem) {
		.heading :global(.mark) {
			height: 1.4em;
		}

		.row {
			flex-direction: row;
		}

		.field {
			flex: 1;
		}

		.button {
			display: inline-flex;
			flex: none;
		}
	}

	/* Wide boxes (homepage, /about): text on the left, form on the right. */
	@container (min-width: 44rem) {
		.layout {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
			column-gap: 2.5rem;
		}

		.field {
			flex: none;
			width: 16rem;
		}

		.note {
			text-align: right;
		}
	}
</style>
