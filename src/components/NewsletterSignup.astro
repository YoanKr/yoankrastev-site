---
/**
 * Newsletter signup: the Risk Appetite mark and name, a pitch and one button. The button is a plain link to the beehiiv
 * signup page (beehiiv can't prefill an email from our site, so there is no email field here).
 * Used on the homepage, at the end of every essay, and on /newsletter.
 * The button label and note come from src/content/pages/newsletter.md.
 */
import { NEWSLETTER } from '../consts';
import { getPageCopy } from '../lib/pages';
import RiskAppetiteMark from './RiskAppetiteMark.astro';

interface Props {
	/** Where it sits ('home', 'essay', 'newsletter'). Sent to beehiiv as utm_medium. */
	placement: string;
	/** Optional heading, as inline HTML from a page's wording file. */
	heading?: string;
	/** Optional pitch under the heading, as HTML from a page's wording file. */
	text?: string;
	/** Lets a page adjust spacing with its own scoped class. */
	/** Draw it as a panel (soft-edged box). Boxed on the homepage, under articles and on /about; plain on /newsletter. */
	boxed?: boolean;
	class?: string;
}

const { placement, heading, text, boxed = true, class: className, ...rest } = Astro.props;
const headingId = `newsletter-heading-${placement}`;
const copy = await getPageCopy('newsletter');

const href = new URL(NEWSLETTER.subscribeUrl);
href.searchParams.set('utm_source', 'website');
href.searchParams.set('utm_medium', placement);
---

<section
	class:list={['newsletter', { panel: boxed }, className]}
	aria-labelledby={heading ? headingId : undefined}
	aria-label={heading ? undefined : 'Newsletter'}
	{...rest}
>
	<div class="layout">
	{
		(heading || text) && (
			<div class="text">
				{heading && (
					<h2 id={headingId} class="heading">
						<RiskAppetiteMark class="mark" />
						<span set:html={heading} />
					</h2>
				)}
				{text && <div class="pitch" set:html={text} />}
			</div>
		)
	}
	<div class="action">
		<a class="button" href={href} set:html={copy.inline('button')} />
		<p class="meta note" set:html={copy.inline('button-note')} />
	</div>
	</div>
</section>

<style>
	/*
	  Phones and narrow boxes: mark and name, pitch, then the button under the pitch.
	  Where the box has room (container query): text on the left, button and note on the right,
	  centred vertically, so the box is neither half-empty nor tall.
	*/
	.newsletter {
		margin-top: var(--space-section);
		container-type: inline-size;
	}

	/* Boxed: a panel across the full width of its column, a little shorter than other panels. */
	.newsletter.panel {
		padding-block: calc(var(--space-panel) * 0.75);
	}

	.layout {
		display: grid;
		gap: 1.5rem;
	}

	.text {
		max-width: var(--measure);
	}

	.heading {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}

	.heading :global(.mark) {
		flex: none;
		height: 1.25em;
	}

	.pitch {
		margin-top: 0.5rem;
	}

	.pitch :global(p + p) {
		margin-top: 1em;
	}

	.button {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0.75rem 1.75rem;
		border-radius: 2px;
		background: var(--color-text);
		color: var(--color-bg);
		font-family: var(--font-sans);
		font-size: var(--text-button);
		font-weight: 600;
		line-height: 1.2;
		text-decoration: none;
	}

	.button:hover {
		background: var(--color-accent);
	}

	@media (min-width: 30em) {
		.button {
			display: inline-flex;
		}
	}

	.note {
		margin-top: 0.625rem;
	}

	/* Medium boxes (the article column): text full width, then the button and its note on one row. */
	@container (min-width: 30rem) {
		.heading :global(.mark) {
			height: 1.4em;
		}

		.action {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: 0.5rem 1.25rem;
		}

		.button {
			display: inline-flex;
		}

		.note {
			margin-top: 0;
		}
	}

	/* Wide boxes (homepage, /about): text on the left, button and note on the right. */
	@container (min-width: 44rem) {
		.layout {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
			column-gap: 2.5rem;
		}

		.action {
			display: block;
			text-align: right;
		}

		.note {
			margin-top: 0.625rem;
		}
	}
</style>
